# PostgreSQL (local development)
# In Vercel, set DATABASE_URL to Neon’s pooled (-pooler) connection string and
# DIRECT_URL to the Neon direct/unpooled string. Keep sslmode=require from Neon.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/the_daily_post?schema=public"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5432/the_daily_post?schema=public"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
ADMIN_PASSWORD="change-this-for-local-development"

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Stripe Billing (create recurring Prices in Stripe and copy their price_ IDs)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_DIGITAL_MONTHLY=
STRIPE_PRICE_DIGITAL_ANNUAL=
STRIPE_PRICE_ALLACCESS_MONTHLY=

# HMAC key for pseudonymous server-side free-article metering.
# Generate a unique random value for each deployment; production may also use CLERK_SECRET_KEY as a fallback.
PAYWALL_METER_SECRET=
# For non-Vercel production only: header overwritten by your trusted proxy with one canonical client IP.
PAYWALL_CLIENT_IP_HEADER=

# Shared production API rate limits (Upstash Redis REST; required in production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# For non-Vercel production only: header overwritten by your trusted proxy with the client IP.
RATE_LIMIT_CLIENT_IP_HEADER=

# Optional integrations
WEATHERAPI_KEY=
OPENWEATHER_API_KEY=
WEATHER_LOCATION=
# Required in production for confirmation and unsubscribe emails.
RESEND_API_KEY=
# Sender identity must use a domain verified in your Resend account.
RESEND_FROM_EMAIL=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_ADSENSE_CLIENT=
CONTEXT7_API_KEY=
LOG_LEVEL=info
